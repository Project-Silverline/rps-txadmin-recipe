# --- RPS framework: add these lines to your server.cfg ---

set mysql_connection_string "mysql://user:password@localhost/dbname?charset=utf8mb4"

# ox_inventory (use setr, not set: the client needs these too)
setr inventory:framework "rps"
setr inventory:slots 40
setr inventory:weight 30000

# Start order matters
ensure oxmysql
ensure ox_lib
ensure rps_core
ensure ox_inventory
ensure illenium-appearance
ensure rps_ambulance

# ox_lib runs add_principal/add_ace for RPS groups and commands; it needs permission
add_ace resource.ox_lib command.add_ace allow
add_ace resource.ox_lib command.remove_ace allow
add_ace resource.ox_lib command.add_principal allow
add_ace resource.ox_lib command.remove_principal allow
