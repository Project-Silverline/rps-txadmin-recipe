# --- RPS framework: add these lines to your server.cfg ---
# Copy ox.cfg (next to recipe.yaml) into your server data folder, beside server.cfg.

set mysql_connection_string "mysql://user:password@localhost/dbname?charset=utf8mb4"

# ox_inventory convars and ox_lib permissions; must run before ox_inventory starts
exec ox.cfg

# Start order matters
ensure oxmysql
ensure ox_lib
ensure rps_core
ensure ox_inventory
ensure illenium-appearance
ensure rps_ambulance
ensure rps_multicharacter
